# Generate a private random value for SECRET_KEY. Never commit the real .env.
SECRET_KEY=replace-with-a-long-random-secret

# Create a Web application OAuth client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Gemini API key (keep private; used by the Flask backend only).
GEMINI_API_KEY=
# Optional model override; defaults in service_classifier.py.
# GEMINI_MODEL=gemini-3.8-flash

# Hosted Postgres/TigerData/Azure. Use either DATABASE_URL or the PG* values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
PGHOST=
PGPORT=5432
PGDATABASE=tsdb
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Discord bot, needed only for bot/bot.py.
DISCORD_TOKEN=
TEST_GUILD_ID=
ANNOUNCEMENT_CHANNEL_IDS=

# Scraper worker loop interval.
OPPORTUNITY_SYNC_INTERVAL_SECONDS=900

# Register the OAUTH_REDIRECT_URI value exactly in Google Cloud Console.

# Leave false for local HTTP. Set true behind HTTPS in production.
COOKIE_SECURE=false

# Optional: after login, send the browser back to the React app.
FRONTEND_URL=http://localhost:5173
