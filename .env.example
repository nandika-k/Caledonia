# Generate a private random value for SECRET_KEY. Never commit the real .env.
SECRET_KEY=replace-with-a-long-random-secret

# Create a Web application OAuth client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/callback

# Register the OAUTH_REDIRECT_URI value exactly in Google Cloud Console.

# Leave false for local HTTP. Set true behind HTTPS in production.
COOKIE_SECURE=false

# Optional: after login, send the browser back to the React app.
# FRONTEND_URL=http://localhost:3000
